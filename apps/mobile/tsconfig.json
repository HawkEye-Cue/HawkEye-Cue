{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*", "App.tsx"],
  "references": [
    { "path": "../../packages/shared" }
  ],
  "exclude": ["node_modules", "dist"]
}
