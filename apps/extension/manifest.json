{
  "manifest_version": 3,
  "name": "HawkEye-Cue",
  "version": "1.5.1",
  "description": "Detect leads and mentions while scrolling social media. A hawk icon appears when someone posts about needing your services.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://m.facebook.com/*",
    "https://www.instagram.com/*",
    "https://www.linkedin.com/*",
    "https://www.tiktok.com/*",
    "https://29p0xwb5v8.execute-api.us-east-1.amazonaws.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://hawkeyecue.com/*",
      "https://*.hawkeyecue.com/*",
      "https://do8mke590kd4p.cloudfront.net/*"
    ]
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.linkedin.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": ["src/content/scanner.js"],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/hawk-16.png",
      "48": "src/icons/hawk-48.png",
      "128": "src/icons/hawk-128.png"
    }
  },
  "icons": {
    "16": "src/icons/hawk-16.png",
    "48": "src/icons/hawk-48.png",
    "128": "src/icons/hawk-128.png"
  }
}
