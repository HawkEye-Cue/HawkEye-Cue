# Copy this file to .env.local and fill in values from CDK outputs
# Run: aws cloudformation describe-stacks --stack-name SocialLeadGen-Auth --query 'Stacks[0].Outputs'

VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_REGION=us-east-1
VITE_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com

# Stripe — get from Stripe Dashboard → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXX
